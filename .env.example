# Node.js 24+, Python 3.9+. Keys remain in the local backend.
OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REPORT_MODEL=gpt-6.1-sol
PYTHON_BIN=python3
PORT=3210
DATA_DIR=.data
# Upper bound per model response. Actual token usage is recorded.
MODEL_MAX_OUTPUT_TOKENS=6000

# Model response timeout in milliseconds (default 3 minutes; max 10 minutes).
MODEL_TIMEOUT_MS=180000
